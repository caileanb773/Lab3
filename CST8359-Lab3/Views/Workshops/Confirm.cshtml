@model CST8359_Lab3.Models.Rsvp

@{
    ViewData["Title"] = "Workshops";
}

<h1>Registration Confirmed</h1>

<h2>@ViewData["Message"]</h2>

<h3>Please review your workshop details:</h3>

<p>You are enrolled in: @Model.WorkshopTitle</p>

@if (Model.NeedsAccomodation)
{
    <p>Your accomodations will be handled for you.</p>
} else
{
    <p>No accomodations requested.</p>
}

<a asp-controller="Workshops" asp-action="Index" class="btn btn-primary">Back to Workshops</a>

<a asp-controller="Workshops" asp-action="Registrations" class="btn btn-secondary">View Registrations</a>