@model CST8359_Lab3.Models.Rsvp

@{
    ViewData["Title"] = "Workshops";
}

<h1>New RSVP</h1>
<p>Register a new RSVP</p>

<form asp-controller="Workshops" asp-action="Confirm" method="post">

    <label asp-for="FullName">Enter your full name:</label>
    <input asp-for="FullName" />

    <br />

    <label asp-for="WorkshopTitle">Which Workshop?</label>
    <select asp-for="WorkshopTitle">
        <option>Woodworking</option>
        <option>Welding</option>
        <option>Pottery</option>
    </select>

    <br />

    <label>
        <input asp-for="NeedsAccommodation" />
        Need Accommodations?
    </label>

    <br />

    <button type="submit">Confirm Registration</button>
</form>
