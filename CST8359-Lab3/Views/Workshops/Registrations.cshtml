@model List<CST8359_Lab3.Models.Rsvp>

@{
    ViewData["Title"] = "View All Workshops";
}

<h1>Registrations</h1>
<p>View active registrations</p>

<table>

    <thead>
        <tr>
            <th>Full Name</th>
            <th>Workshop</th>
            <th>Accomodations</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var registration in Model)
        {
            <tr>
                <td>@registration.FullName</td>
                <td>@registration.WorkshopTitle</td>
                <td>@registration.NeedsAccomodation</td>
            </tr>
        }

    </tbody>

</table>

